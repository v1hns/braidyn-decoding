\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}The personal decoder's advantage erodes over the protocol}{4}{subsection.4.3}\protected@file@percent }
\newlabel{sec:decay}{{4.3}{4}{The personal decoder's advantage erodes over the protocol}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Decoding accuracy across the 15-day protocol for the personal decoder (own early data) and the pooled decoder (other mice's early data), with per-day points and linear fits. The personal decoder starts ahead, and the pooled decoder gains more over days, so the gap between them narrows. The narrowing is significant for lick and reward, the two events where the personal decoder also loses accuracy over days, and is not significant for lever pull or tone. The per-event gap slope and its $p$ (paired sign-flip over mice) are shown.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:decay}{{1}{5}{Decoding accuracy across the 15-day protocol for the personal decoder (own early data) and the pooled decoder (other mice's early data), with per-day points and linear fits. The personal decoder starts ahead, and the pooled decoder gains more over days, so the gap between them narrows. The narrowing is significant for lick and reward, the two events where the personal decoder also loses accuracy over days, and is not significant for lever pull or tone. The per-event gap slope and its $p$ (paired sign-flip over mice) are shown}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}The robustness is not a data-volume artifact}{5}{subsection.4.4}\protected@file@percent }
\newlabel{sec:matched}{{4.4}{5}{The robustness is not a data-volume artifact}{subsection.4.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Diversity: a secondary scaling with the number of training individuals}{5}{subsection.4.5}\protected@file@percent }
\newlabel{sec:scaling}{{4.5}{5}{Diversity: a secondary scaling with the number of training individuals}{subsection.4.5}{}}
\citation{allenvb2023}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Left:} count-matched control. With equal numbers of training events, decoder aging (AUC lost from early to late; lower values indicate greater robustness) is compared for the subject's own data (self), one other mouse, and many other mice. \textbf  {Right:} pooled aging as a function of the number of training mice $N$. Greater diversity provides a small additional gain, with immediate saturation for lever pull.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:mech}{{2}{6}{\textbf {Left:} count-matched control. With equal numbers of training events, decoder aging (AUC lost from early to late; lower values indicate greater robustness) is compared for the subject's own data (self), one other mouse, and many other mice. \textbf {Right:} pooled aging as a function of the number of training mice $N$. Greater diversity provides a small additional gain, with immediate saturation for lever pull}{figure.2}{}}
